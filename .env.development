# 开发环境配置
APP_ENV=development
APP_DEBUG=true
APP_HOST=localhost
APP_PORT=8501

# 日志配置
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# DeepSeek API配置
DEEPSEEK_API_KEY=your_development_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 安全配置
SECRET_KEY=development_secret_key_change_in_production

# 开发工具配置
RELOAD=true
SHOW_ERROR_DETAILS=true